# Copy this file to .env and fill in real values from your Supabase project.
# Find these at: https://app.supabase.com/project/_/settings/api

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=ey...your_anon_public_key

# Where the web version of this app is hosted. Used as the base URL for QR codes.
# In development this is the Expo dev server (e.g. http://192.168.1.50:8081).
# When you deploy the web build, replace it with the deployed URL.
EXPO_PUBLIC_QR_LANDING_BASE_URL=http://localhost:8081
