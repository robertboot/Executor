# Public — embedded in the browser bundle. Same values as the Expo app.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Server-only — used by server actions / API routes that need to bypass RLS
# (e.g. generating embeddings, scheduled tasks). Get from Supabase →
# Project Settings → API → service_role key. NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Image embedding provider (used by the scan/recognize feature). Pick one
# of: voyage | cohere | openai. Leave blank to disable the feature for now.
EMBEDDING_PROVIDER=
VOYAGE_API_KEY=
COHERE_API_KEY=
OPENAI_API_KEY=
